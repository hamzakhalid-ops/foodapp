# =============================================================================
# QuickBite — environment configuration template
# =============================================================================
#
# Copy to `.env` for LOCAL DEVELOPMENT ONLY:   cp .env.example .env
#
# * `.env` and `.env.*` are git-ignored. Never commit real credentials.
# * Staging/production values come from the deployment platform's secret manager
#   (docs/infrastructure/INFRASTRUCTURE_RULES.md §21–22, DEPLOYMENT_SPEC §19–21).
# * Every value below is either a non-secret local default or intentionally empty.
# * Variables marked [validated] are enforced at backend startup today
#   (backend/src/config/env.schema.ts). Others are catalogued here and become
#   validated by the slice that first uses them.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development                 # [validated] development | test | production
APP_ENV=development                  # [validated] development | test | staging | production
APP_VERSION=0.0.0-local              # [validated] release identifier (set by CI/CD)

# -----------------------------------------------------------------------------
# API (backend)
# -----------------------------------------------------------------------------
API_PORT=3000                        # [validated]
API_CORS_ORIGINS=http://localhost:3100,http://localhost:8081   # [validated] comma-separated
API_TRUST_PROXY=false                # [validated] true behind a reverse proxy / load balancer

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL (durable source of truth)
# Matches infrastructure/local/docker-compose.yml (local-only credentials).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://quickbite:quickbite_local_only@localhost:5432/quickbite   # [validated]

# -----------------------------------------------------------------------------
# REDIS — cache, rate limiting, presence, dispatch coordination, locks, BullMQ
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379     # [validated]

# -----------------------------------------------------------------------------
# LOGGING / MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug                      # [validated] fatal | error | warn | info | debug | trace
LOG_PRETTY=true                      # [validated] human-readable logs (local only)
SENTRY_DSN=                          # [validated] empty disables Sentry
SENTRY_TRACES_SAMPLE_RATE=0          # [validated] 0..1

# -----------------------------------------------------------------------------
# AUTH (Slice 1) — docs/security/AUTH_AUTHORIZATION.md
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL=                    # e.g. 15m — configured centrally (AUTH_AUTHORIZATION §22)
REFRESH_TOKEN_TTL=                   # e.g. 30d
JWT_ACCESS_SECRET=                   # SECRET — generate locally, never commit
JWT_ISSUER=quickbite
JWT_AUDIENCE=quickbite-api

# -----------------------------------------------------------------------------
# OBJECT STORAGE — S3-compatible (StorageService abstraction)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=                    # empty = provider default endpoint
STORAGE_REGION=
STORAGE_BUCKET_PRIVATE=              # documents (restaurant/rider), never public
STORAGE_BUCKET_PUBLIC=               # menu/restaurant images served via CDN
STORAGE_ACCESS_KEY_ID=               # SECRET
STORAGE_SECRET_ACCESS_KEY=           # SECRET
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# MAPS — Google Maps Platform (MapsService abstraction)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_SERVER_API_KEY=          # SECRET — backend only (geocoding, distance)

# -----------------------------------------------------------------------------
# PAYMENTS (Slice 8) — PaymentService abstraction
# Provider not yet selected (see docs/REPOSITORY_CONSISTENCY_REPORT.md).
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=                    # provider identifier, e.g. set when approved
PAYMENT_API_KEY=                     # SECRET
PAYMENT_WEBHOOK_SECRET=              # SECRET — webhook signature verification

# -----------------------------------------------------------------------------
# NOTIFICATIONS — NotificationService abstraction
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=                      # Firebase Cloud Messaging (Android; iOS via APNs)
FCM_SERVICE_ACCOUNT_JSON=            # SECRET — inject via secret manager, never a committed file
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=                    # SECRET
APNS_BUNDLE_IDS=                     # comma-separated app bundle identifiers
SMS_PROVIDER=                        # not yet selected
SMS_API_KEY=                         # SECRET
EMAIL_PROVIDER=                      # not yet selected
EMAIL_API_KEY=                       # SECRET
EMAIL_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# CLIENT APPS — PUBLIC values only (embedded in app bundles; never secrets)
# -----------------------------------------------------------------------------
# Expo apps (apps/customer, apps/restaurant, apps/rider)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=     # restricted client key (by app signature)
EXPO_PUBLIC_SENTRY_DSN=
# Admin Panel (apps/admin)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
