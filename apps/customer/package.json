{
  "name": "@quickbite/customer",
  "version": "0.0.0",
  "private": true,
  "description": "QuickBite Customer App \u2014 Expo / React Native (customers ordering food).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "clean": "rm -rf dist .expo .turbo"
  },
  "dependencies": {
    "@expo/log-box": "~57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "5.9.1",
    "@quickbite/api-client": "workspace:*",
    "@quickbite/types": "workspace:*",
    "@quickbite/validation": "workspace:*",
    "@tanstack/react-query": "5.104.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@quickbite/config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
