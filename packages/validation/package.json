{
  "name": "@quickbite/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod schemas for QuickBite client-side input shape validation and API envelope parsing.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@quickbite/types": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@quickbite/config": "workspace:*",
    "@types/jest": "30.0.0",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
