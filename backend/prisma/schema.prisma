// QuickBite V1 — Prisma schema
//
// The database design is governed by docs/database/DATABASE.md. Do NOT add models here that are
// not defined there. Tables are introduced slice by slice (docs/IMPLEMENTATION_PLAN.md), each
// with a version-controlled migration under prisma/migrations/.
//
// Conventions (DATABASE.md §64–68, CLAUDE.md §8):
//   * Money: Decimal @db.Decimal(12, 2) plus a currency column. Never Float.
//   * Timestamps: DateTime @db.Timestamptz(6), stored in UTC.
//   * Table/column names: snake_case via @@map / @map; Prisma model/field names: PascalCase/camelCase.
//   * Foreign keys, unique constraints and indexes are declared explicitly.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — DATABASE.md §4–6 (Slice 1)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  RESTRICTED
  DEACTIVATED
  PENDING_VERIFICATION

  @@map("user_status")
}

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_OPERATOR
  RIDER
  ADMIN
  SUPER_ADMIN

  @@map("role")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String     @map("password_hash")
  status          UserStatus
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                  UserRole[]
  customerProfile        CustomerProfile?
  sessions               UserSession[]
  verificationChallenges VerificationChallenge[]
  auditLogs              AuditLog[]
  updatedSettings        SystemSetting[]         @relation("SystemSettingUpdater")
  idempotencyKeys        IdempotencyKey[]
  addresses              Address[]
  restaurantOwnerProfile RestaurantOwnerProfile?
  ownedRestaurants       Restaurant[]            @relation("RestaurantOwner")
  restaurantMemberships  RestaurantStaff[]
  reviewedApplications   RestaurantApplication[] @relation("ApplicationReviewer")
  uploadedDocuments      RestaurantDocument[]    @relation("DocumentUploader")
  reviewedDocuments      RestaurantDocument[]    @relation("DocumentReviewer")
  cart                   Cart?
  orders                 Order[]
  orderStatusChanges     OrderStatusHistory[]
  payments               Payment[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@map("user_roles")
}

model CustomerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  profileImageUrl String?   @map("profile_image_url")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("customer_profiles")
}

/// DATABASE.md §7. At most one default address per user (partial unique index in migration).
model Address {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  label                String?
  recipientName        String   @map("recipient_name")
  phone                String
  addressLine1         String   @map("address_line_1")
  addressLine2         String?  @map("address_line_2")
  area                 String?
  city                 String
  postalCode           String?  @map("postal_code")
  latitude             Decimal  @db.Decimal(9, 6)
  longitude            Decimal  @db.Decimal(9, 6)
  deliveryInstructions String?  @map("delivery_instructions")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Authentication storage — DATABASE.md §5.1 (Slice 1)
// ---------------------------------------------------------------------------

enum SessionRevokedReason {
  LOGOUT
  PASSWORD_RESET
  PASSWORD_CHANGED
  REFRESH_TOKEN_REUSE
  ACCOUNT_SUSPENDED
  ADMIN_ACTION

  @@map("session_revoked_reason")
}

model UserSession {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime              @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason SessionRevokedReason? @map("revoked_reason")
  ipAddress     String?               @map("ip_address")
  userAgent     String?               @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum VerificationChallengeType {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_challenge_type")
}

model VerificationChallenge {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  type          VerificationChallengeType
  target        String
  secretHash    String                    @unique @map("secret_hash")
  attempts      Int                       @default(0)
  maxAttempts   Int                       @map("max_attempts")
  expiresAt     DateTime                  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?                 @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt DateTime?                 @map("invalidated_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@map("verification_challenges")
}

// ---------------------------------------------------------------------------
// Audit — DATABASE.md §59 (append-only; first used by Slice 1 security events)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// System — DATABASE.md §60–62 (cross-cutting infrastructure)
// ---------------------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  valueType   String   @map("value_type")
  description String?
  isSensitive Boolean  @default(false) @map("is_sensitive")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation("SystemSettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String
  userId         String   @map("user_id") @db.Uuid
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_status")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  /// Monotonic order of creation (events of one transaction share created_at).
  sequence      BigInt       @unique @default(autoincrement())
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Restaurants — DATABASE.md §8–15 (Slice 3)
// ---------------------------------------------------------------------------

enum RestaurantStatus {
  OFFLINE
  ONLINE
  TEMPORARILY_PAUSED
  CLOSED
  SUSPENDED

  @@map("restaurant_status")
}

enum RestaurantApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED

  @@map("restaurant_approval_status")
}

/// Owner name captured at restaurant registration (API_SPEC §44). Gap fill: DATABASE.md §5.4.
model RestaurantOwnerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("restaurant_owner_profiles")
}

model Restaurant {
  id                 String                   @id @default(uuid()) @db.Uuid
  ownerUserId        String                   @map("owner_user_id") @db.Uuid
  name               String
  slug               String                   @unique
  description        String?
  phone              String?
  email              String?
  logoUrl            String?                  @map("logo_url")
  coverImageUrl      String?                  @map("cover_image_url")
  status             RestaurantStatus         @default(OFFLINE)
  approvalStatus     RestaurantApprovalStatus @default(DRAFT) @map("approval_status")
  pausedUntil        DateTime?                @map("paused_until") @db.Timestamptz(6)
  statusReason       String?                  @map("status_reason")
  latitude           Decimal?                 @db.Decimal(9, 6)
  longitude          Decimal?                 @db.Decimal(9, 6)
  addressLine1       String?                  @map("address_line_1")
  addressLine2       String?                  @map("address_line_2")
  area               String?
  city               String?
  postalCode         String?                  @map("postal_code")
  cuisineDescription String?                  @map("cuisine_description")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner            User                        @relation("RestaurantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  application      RestaurantApplication?
  staff            RestaurantStaff[]
  documents        RestaurantDocument[]
  operatingHours   RestaurantOperatingHours[]
  deliverySettings RestaurantDeliverySettings?
  paymentAccounts  RestaurantPaymentAccount[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  carts            Cart[]
  orders           Order[]

  @@index([status])
  @@index([approvalStatus])
  @@map("restaurants")
}

model RestaurantApplication {
  id                  String                   @id @default(uuid()) @db.Uuid
  restaurantId        String                   @unique @map("restaurant_id") @db.Uuid
  status              RestaurantApprovalStatus @default(DRAFT)
  /// Business information submitted for admin review (PRD §9). Gap fill: DATABASE.md §5.4.
  businessInformation Json?                    @map("business_information")
  submittedAt         DateTime?                @map("submitted_at") @db.Timestamptz(6)
  reviewedAt          DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy          String?                  @map("reviewed_by") @db.Uuid
  rejectionReason     String?                  @map("rejection_reason")
  resubmissionNotes   String?                  @map("resubmission_notes")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  reviewer   User?      @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("restaurant_applications")
}

enum RestaurantStaffRole {
  OWNER
  OPERATOR

  @@map("restaurant_staff_role")
}

enum RestaurantStaffStatus {
  ACTIVE
  INACTIVE

  @@map("restaurant_staff_status")
}

/// V1: a user has at most one ACTIVE membership (partial unique index in migration).
model RestaurantStaff {
  id           String                @id @default(uuid()) @db.Uuid
  restaurantId String                @map("restaurant_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  role         RestaurantStaffRole
  status       RestaurantStaffStatus @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, userId])
  @@index([userId])
  @@map("restaurant_staff")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("document_status")
}

model RestaurantDocument {
  id              String         @id @default(uuid()) @db.Uuid
  restaurantId    String         @map("restaurant_id") @db.Uuid
  documentType    String         @map("document_type")
  /// Private object-storage key (never a public URL, API_SPEC §109).
  fileUrl         String         @map("file_url")
  status          DocumentStatus @default(PENDING)
  uploadedBy      String         @map("uploaded_by") @db.Uuid
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  uploader   User       @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  reviewer   User?      @relation("DocumentReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@map("restaurant_documents")
}

/// ISO day of week 1 (Monday) … 7 (Sunday); times in the business timezone (ADR-0014 §6).
model RestaurantOperatingHours {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt
  opensAt      String?  @map("opens_at") @db.Char(5)
  closesAt     String?  @map("closes_at") @db.Char(5)
  isClosed     Boolean  @default(false) @map("is_closed")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("restaurant_operating_hours")
}

model RestaurantDeliverySettings {
  id                          String   @id @default(uuid()) @db.Uuid
  restaurantId                String   @unique @map("restaurant_id") @db.Uuid
  deliveryEnabled             Boolean  @default(true) @map("delivery_enabled")
  minimumOrderAmount          Decimal  @default(0) @map("minimum_order_amount") @db.Decimal(12, 2)
  estimatedPreparationMinutes Int      @map("estimated_preparation_minutes")
  /// Kilometres (MAPS_LOCATION_RULES §12).
  deliveryRadius              Decimal  @map("delivery_radius") @db.Decimal(6, 2)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_delivery_settings")
}

enum PaymentAccountStatus {
  ACTIVE
  INACTIVE

  @@map("payment_account_status")
}

/// Stores provider references only, never raw credentials (DATABASE.md §15).
model RestaurantPaymentAccount {
  id                String               @id @default(uuid()) @db.Uuid
  restaurantId      String               @map("restaurant_id") @db.Uuid
  provider          String
  accountReference  String               @map("account_reference")
  accountHolderName String               @map("account_holder_name")
  status            PaymentAccountStatus @default(ACTIVE)
  isDefault         Boolean              @default(false) @map("is_default")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@map("restaurant_payment_accounts")
}

// ---------------------------------------------------------------------------
// Menu — DATABASE.md §16–20 (Slice 4)
// ---------------------------------------------------------------------------

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  basePrice    Decimal  @map("base_price") @db.Decimal(12, 2)
  isAvailable  Boolean  @default(true) @map("is_available")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variations ItemVariation[]
  addOns     ItemAddOn[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model ItemVariation {
  id              String   @id @default(uuid()) @db.Uuid
  menuItemId      String   @map("menu_item_id") @db.Uuid
  name            String
  priceAdjustment Decimal  @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem       MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  cartSelections CartItemVariation[]
  orderSnapshots OrderItemVariation[]

  @@index([menuItemId])
  @@map("item_variations")
}

model ItemAddOn {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  name       String
  price      Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem       MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  cartSelections CartItemAddOn[]
  orderSnapshots OrderItemAddOn[]

  @@index([menuItemId])
  @@map("item_add_ons")
}

// ----------------------------------------------------------------------------- Cart (ADR-0014 §4)

/// One active cart per customer, holding items of a single restaurant (ORDER_RULES §4.1).
/// Carts never store prices; totals are recalculated on every read and at checkout.
model Cart {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @unique @map("customer_id") @db.Uuid
  restaurantId String?  @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @map("cart_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart       Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variations CartItemVariation[]
  addOns     CartItemAddOn[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemVariation {
  cartItemId  String @map("cart_item_id") @db.Uuid
  variationId String @map("variation_id") @db.Uuid

  cartItem  CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  variation ItemVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@id([cartItemId, variationId])
  @@map("cart_item_variations")
}

model CartItemAddOn {
  cartItemId String @map("cart_item_id") @db.Uuid
  addOnId    String @map("add_on_id") @db.Uuid

  cartItem CartItem  @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addOn    ItemAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([cartItemId, addOnId])
  @@map("cart_item_add_ons")
}

// ----------------------------------------------------------------------------- Orders (DATABASE.md §21–27)

enum OrderStatus {
  PENDING
  RESTAURANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_RESTAURANT
  CANCELLED_BY_ADMIN

  @@map("order_status")
}

enum PaymentMethod {
  ONLINE_PAYMENT
  CASH_ON_DELIVERY

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

model Order {
  id                          String        @id @default(uuid()) @db.Uuid
  /// Customer-facing number, e.g. QB-100042 (DATABASE.md §22); never the primary key.
  orderNumber                 String        @unique @default(dbgenerated("('QB-'::text || nextval('order_number_seq'::regclass))")) @map("order_number")
  customerId                  String        @map("customer_id") @db.Uuid
  restaurantId                String        @map("restaurant_id") @db.Uuid
  deliveryAddressId           String?       @map("delivery_address_id") @db.Uuid
  status                      OrderStatus
  paymentMethod               PaymentMethod @map("payment_method")
  paymentStatus               PaymentStatus @map("payment_status")
  subtotal                    Decimal       @db.Decimal(12, 2)
  discountAmount              Decimal       @map("discount_amount") @db.Decimal(12, 2)
  deliveryFee                 Decimal       @map("delivery_fee") @db.Decimal(12, 2)
  taxAmount                   Decimal       @map("tax_amount") @db.Decimal(12, 2)
  serviceFee                  Decimal       @map("service_fee") @db.Decimal(12, 2)
  totalAmount                 Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency                    String        @db.Char(3)
  /// FK added with the promotions slice.
  promotionId                 String?       @map("promotion_id") @db.Uuid
  specialInstructions         String?       @map("special_instructions")
  estimatedPreparationMinutes Int           @map("estimated_preparation_minutes")
  // Delivery destination snapshot (MAPS_LOCATION_RULES §25).
  deliveryRecipientName       String        @map("delivery_recipient_name")
  deliveryRecipientPhone      String        @map("delivery_recipient_phone")
  deliveryAddressText         String        @map("delivery_address_text")
  deliveryArea                String?       @map("delivery_area")
  deliveryCity                String        @map("delivery_city")
  deliveryPostalCode          String?       @map("delivery_postal_code")
  deliveryLatitude            Decimal       @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude           Decimal       @map("delivery_longitude") @db.Decimal(9, 6)
  deliveryInstructions        String?       @map("delivery_instructions")
  placedAt                    DateTime      @map("placed_at") @db.Timestamptz(6)
  acceptedAt                  DateTime?     @map("accepted_at") @db.Timestamptz(6)
  preparingAt                 DateTime?     @map("preparing_at") @db.Timestamptz(6)
  readyAt                     DateTime?     @map("ready_at") @db.Timestamptz(6)
  pickedUpAt                  DateTime?     @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt                 DateTime?     @map("delivered_at") @db.Timestamptz(6)
  cancelledAt                 DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer        User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  deliveryAddress Address?             @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]

  @@index([customerId, createdAt])
  @@index([restaurantId, status])
  @@index([status])
  @@map("orders")
}

/// `unit_price` is the item's base price; `subtotal` = (unit_price + variation adjustments +
/// add-on prices) × quantity. All names and prices are snapshots (DATABASE.md §23–25).
model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  menuItemId String?  @map("menu_item_id") @db.Uuid
  itemName   String   @map("item_name")
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity   Int
  subtotal   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem   MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variations OrderItemVariation[]
  addOns     OrderItemAddOn[]

  @@index([orderId])
  @@map("order_items")
}

/// `quantity` is per unit of the order item (1 in V1).
model OrderItemVariation {
  id              String   @id @default(uuid()) @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  variationId     String?  @map("variation_id") @db.Uuid
  name            String
  priceAdjustment Decimal  @map("price_adjustment") @db.Decimal(12, 2)
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variation ItemVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_variations")
}

/// `quantity` is per unit of the order item (1 in V1).
model OrderItemAddOn {
  id          String   @id @default(uuid()) @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  addOnId     String?  @map("add_on_id") @db.Uuid
  name        String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  addOn     ItemAddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_add_ons")
}

/// Append-only (ORDER_RULES §24); enforced by a trigger.
model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  reason          String?
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ----------------------------------------------------------------------------- Payments (DATABASE.md §28–29)

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  /// Provider adapter name; null for cash on delivery.
  provider          String?
  providerPaymentId String?       @map("provider_payment_id")
  method            PaymentMethod
  status            PaymentStatus
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  idempotencyKey    String?       @map("idempotency_key")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@map("payments")
}
