{
  "name": "@quickbite/backend",
  "version": "0.0.0",
  "private": true,
  "description": "QuickBite V1 backend \u2014 NestJS modular monolith (REST /api/v1 + Socket.IO + BullMQ workers).",
  "scripts": {
    "build": "pnpm db:generate && nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:api": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects api",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest -c test/jest-integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate && prisma format --check",
    "clean": "rm -rf dist src/generated .turbo"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/websockets": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@quickbite/types": "workspace:*",
    "@sentry/nestjs": "11.0.0",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@quickbite/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
